# Use postgresql+psycopg://USER:PASSWORD@HOST:5432/DB in production.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/resume_analyzer
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:5173
# Comma-separated. Leave unset to use FRONTEND_URL.
CORS_ORIGINS=
MAX_UPLOAD_SIZE_MB=5
OPENAI_TIMEOUT_SECONDS=30
SKILL_MATCH_WEIGHT=0.4
KEYWORD_MATCH_WEIGHT=0.2
SEMANTIC_MATCH_WEIGHT=0.2
EXPERIENCE_MATCH_WEIGHT=0.1
EDUCATION_MATCH_WEIGHT=0.1
